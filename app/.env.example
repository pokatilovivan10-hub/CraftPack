# Скопируйте в .env и заполните реальными значениями.
# Никогда не коммитьте реальные секреты.

# Подключение к MySQL (создаётся платформой при разработке)
DATABASE_URL=mysql://user:password@host:3306/kraftpak

# Токен доступа к админке импорта (/admin/catalog-import)
ADMIN_TOKEN=change-me-long-random-string

# Базовый URL сайта для sitemap.xml и canonical
SITE_URL=https://kraftpak.shop

# Адаптер уведомлений менеджеру о новых заявках (webhook → почта/CRM).
# Если не задан, заявка сохраняется в базу со статусом notifyStatus=pending/failed.
ORDER_NOTIFY_WEBHOOK_URL=

# Заполняются платформой Kimi при сборке (не трогайте вручную)
APP_ID=
APP_SECRET=
